    {
      "id": 4,
      "type": "table",
      "title": "Latest messages",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "soracom"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "soracom"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/messages",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "imsi",
                "value": "${imsi}"
              },
              {
                "key": "limit",
                "value": "100"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "meta.imsi",
              "text": "imsi",
              "type": "string"
            },
            {
              "selector": "meta.source",
              "text": "source",
              "type": "string"
            },
            {
              "selector": "data",
              "text": "data",
              "type": "string"
            },
            {
              "selector": "text",
              "text": "text",
              "type": "string"
            },
            {
              "selector": "raw",
              "text": "raw (base64)",
              "type": "string"
            }
          ],
          "filters": []
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "time",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "time": 0,
              "imsi": 1,
              "source": 2,
              "data": 3,
              "text": 4,
              "raw (base64)": 5
            },
            "excludeByName": {},
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "imsi"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "source"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          }
        ]
      }
